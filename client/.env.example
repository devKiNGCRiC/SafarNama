# Backend API URL
VITE_API_URL=http://localhost:5000

# Public folder for images
VITE_PUBLIC_FOLDER=http://localhost:5000/images/

# Google OAuth (Optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Facebook OAuth (Optional)
VITE_FACEBOOK_APP_ID=your_facebook_app_id

# Google Maps API (Optional)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Analytics (Optional)
VITE_GA_TRACKING_ID=your_google_analytics_id

# Booking & payment pages are hidden until this is "true" (server: ENABLE_BOOKING)
VITE_ENABLE_BOOKING=false

# Unfinished sections stay hidden until their flag is "true"
VITE_ENABLE_EVENTS=false
VITE_ENABLE_ECO_GUIDES=false
VITE_ENABLE_SOCIAL_LOGIN=false
